[Unit]
Description=Recover ready WEI LAN DataForSEO results
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=openclaw
Group=openclaw
WorkingDirectory=/home/openclaw/workspace/monitor
ExecStart=/usr/bin/python3 /home/openclaw/workspace/monitor/serp_recovery.py --config /home/openclaw/workspace/monitor/serp-config.json
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/openclaw/workspace/monitor/reports
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
